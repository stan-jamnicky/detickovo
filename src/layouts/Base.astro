---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieNotice from '../components/CookieNotice.astro';
import site from '../data/site.json';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/uploads/hero.svg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const maintenance = site.maintenance ?? false;
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    {maintenance && (
      <script is:inline>
        // Maintenance gate — admins bypass it via /udrzba?nahlad=1
        try {
          var q = new URLSearchParams(location.search).get('nahlad');
          if (q === '1') localStorage.setItem('detickovo-nahlad', '1');
          if (q === '0') localStorage.removeItem('detickovo-nahlad');
          if (localStorage.getItem('detickovo-nahlad') !== '1') location.replace('/udrzba');
        } catch (e) {
          location.replace('/udrzba');
        }
      </script>
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/fav_icon.png" />
    <link rel="apple-touch-icon" href="/fav_icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="sk_SK" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-3">Preskočiť na obsah</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieNotice />
  </body>
</html>
