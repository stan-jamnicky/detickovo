---
// Decorative confetti sprinkle; positioned by the parent via class
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg class={`pointer-events-none ${className}`} viewBox="0 0 200 120" fill="none" aria-hidden="true">
  <circle cx="20" cy="30" r="7" fill="#00adee" />
  <circle cx="90" cy="14" r="5" fill="#ed2d28" />
  <circle cx="170" cy="40" r="6" fill="#70be44" />
  <rect x="50" y="70" width="14" height="14" rx="4" fill="#fbb02f" transform="rotate(18 57 77)" />
  <rect x="130" y="80" width="12" height="12" rx="3" fill="#c94096" transform="rotate(-24 136 86)" />
  <circle cx="185" cy="95" r="5" fill="#f1ea38" />
  <path d="M100 55c6-8 14-8 20 0" stroke="#00adee" stroke-width="4" stroke-linecap="round" />
</svg>
