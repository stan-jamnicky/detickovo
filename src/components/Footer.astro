---
import site from '../data/site.json';
import SocialIcons from './SocialIcons.astro';
const year = new Date().getFullYear();
---

<footer class="bg-ink text-white">
  <div class="container-site grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <img src="/logo_2026_negative.png" alt={site.name} class="h-8 w-auto" width="615" height="108" loading="lazy" />
      <p class="mt-3 text-sm text-white/70">{site.tagline}.</p>
    </div>
    <div>
      <p class="font-display font-bold">Služby</p>
      <ul class="mt-3 space-y-2 text-sm text-white/70">
        <li><a href="/velke-akcie" class="hover:text-white">Veľké akcie</a></li>
        <li><a href="/pobytove-tabory" class="hover:text-white">Pobytové tábory</a></li>
        <li><a href="/narodeniny" class="hover:text-white">Narodeninové oslavy</a></li>
        <li><a href="/svadby" class="hover:text-white">Svadby</a></li>
        <li><a href="/akcie" class="hover:text-white">Naše akcie</a></li>
      </ul>
    </div>
    <div>
      <p class="font-display font-bold">Kontakt</p>
      <ul class="mt-3 space-y-2 text-sm text-white/70">
        <li><a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a></li>
        <li><a href={`tel:${site.phone.replace(/\s/g, '')}`} class="hover:text-white">{site.phoneDisplay}</a></li>
        <li>{site.city}</li>
      </ul>
    </div>
    <div>
      <p class="font-display font-bold">Sledujte nás</p>
      <SocialIcons class="mt-3 text-white/70" />
      <a href="/objednavka" class="btn-light mt-6 !px-5 !py-2.5 text-sm">Overiť dostupnosť</a>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-site flex flex-col gap-2 py-5 text-xs text-white/50 sm:flex-row sm:justify-between">
      <p>© {year} {site.name}. Všetky práva vyhradené.</p>
      <a href="/ochrana-sukromia" class="hover:text-white">Ochrana súkromia</a>
    </div>
  </div>
</footer>
