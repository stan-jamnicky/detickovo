---
---

<dialog
  data-mascot-dialog
  class="hidden open:flex open:flex-col fixed inset-0 m-0 h-dvh w-dvw max-h-none max-w-none border-0 bg-white/60 p-0 text-ink backdrop:bg-white/35 backdrop:backdrop-blur-md backdrop-blur-md overflow-hidden z-50"
  aria-label="Detail maskota"
>
  <div class="pointer-events-none absolute inset-x-0 top-0 z-30 flex items-start justify-between p-3 sm:p-5 select-none">
    <div class="pointer-events-auto flex items-center rounded-full bg-white/85 p-1 shadow-lg shadow-ink/10 ring-1 ring-ink/10 backdrop-blur-md" role="group" aria-label="Ovládanie priblíženia" data-mascot-ui>
      <button
        type="button"
        data-mascot-zoom-out
        class="flex h-9 w-9 items-center justify-center rounded-full text-ink/70 transition hover:bg-sand hover:text-ink cursor-pointer"
        aria-label="Oddialiť"
        title="Oddialiť (−)"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" /></svg>
      </button>
      <button
        type="button"
        data-mascot-zoom-reset
        class="h-9 rounded-full px-2.5 font-mono text-xs font-semibold text-ink/80 transition hover:bg-sand hover:text-ink cursor-pointer"
        aria-label="Obnoviť priblíženie"
        title="Obnoviť na 100%"
      >
        <span data-mascot-zoom-level>100%</span>
      </button>
      <button
        type="button"
        data-mascot-zoom-in
        class="flex h-9 w-9 items-center justify-center rounded-full text-ink/70 transition hover:bg-sand hover:text-ink cursor-pointer"
        aria-label="Priblížiť"
        title="Priblížiť (+)"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
      </button>
    </div>

    <button
      type="button"
      data-mascot-close
      data-mascot-ui
      class="pointer-events-auto flex h-11 w-11 items-center justify-center rounded-full bg-white/90 text-ink shadow-lg shadow-ink/10 ring-1 ring-ink/10 backdrop-blur-md transition hover:bg-white hover:scale-105 cursor-pointer"
      aria-label="Zavrieť detail maskota"
      title="Zavrieť (Esc)"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Interactive Image Viewport -->
  <div
    class="relative flex-1 w-full h-dvh overflow-hidden flex items-center justify-center touch-none select-none bg-white/25 backdrop-blur-md px-4 pb-28 pt-20 sm:pb-34 sm:pt-24"
    data-mascot-viewport
  >
    <button
      type="button"
      data-mascot-prev
      data-mascot-ui
      class="absolute left-3 top-1/2 z-20 hidden h-14 w-14 -translate-y-1/2 items-center justify-center rounded-full bg-white/85 text-ink shadow-xl shadow-ink/10 ring-1 ring-ink/10 backdrop-blur-md transition hover:bg-white hover:-translate-x-1 disabled:pointer-events-none disabled:opacity-0 md:flex lg:left-6"
      aria-label="Predchádzajúci maskot"
      title="Predchádzajúci maskot"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <img
      src=""
      alt=""
      class="max-h-[calc(100dvh-11rem)] max-w-[92vw] object-contain pointer-events-none select-none will-change-transform rounded-2xl shadow-2xl shadow-ink/15 ring-1 ring-ink/5 sm:max-h-[calc(100dvh-12rem)]"
      data-mascot-img
      draggable="false"
    />

    <button
      type="button"
      data-mascot-next
      data-mascot-ui
      class="absolute right-3 top-1/2 z-20 hidden h-14 w-14 -translate-y-1/2 items-center justify-center rounded-full bg-white/85 text-ink shadow-xl shadow-ink/10 ring-1 ring-ink/10 backdrop-blur-md transition hover:bg-white hover:translate-x-1 disabled:pointer-events-none disabled:opacity-0 md:flex lg:right-6"
      aria-label="Ďalší maskot"
      title="Ďalší maskot"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <nav
      data-mascot-ui
      data-mascot-carousel
      class="pointer-events-auto absolute inset-x-0 bottom-1 z-30 mx-auto flex w-full max-w-2xl flex-col items-center px-3 sm:bottom-3"
      aria-label="Výber maskota"
    >
      <div class="relative h-28 w-full max-w-132 sm:h-32" data-mascot-avatars></div>
      <div class="relative z-40 -mt-7 max-w-[min(24rem,90vw)] rounded-full bg-white/92 px-4 py-1.5 text-center font-display text-sm font-bold leading-tight text-ink shadow-lg shadow-ink/10 ring-1 ring-ink/10 backdrop-blur-md sm:-mt-8 sm:text-base" data-mascot-current-name></div>
    </nav>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-mascot-dialog]')!;
  const viewport = dialog.querySelector<HTMLElement>('[data-mascot-viewport]')!;
  const img = dialog.querySelector<HTMLImageElement>('[data-mascot-img]')!;
  const zoomInBtn = dialog.querySelector<HTMLButtonElement>('[data-mascot-zoom-in]');
  const zoomOutBtn = dialog.querySelector<HTMLButtonElement>('[data-mascot-zoom-out]');
  const zoomResetBtn = dialog.querySelector<HTMLButtonElement>('[data-mascot-zoom-reset]');
  const zoomLevel = dialog.querySelector<HTMLElement>('[data-mascot-zoom-level]');
  const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-mascot-close]');
  const prevBtn = dialog.querySelector<HTMLButtonElement>('[data-mascot-prev]');
  const nextBtn = dialog.querySelector<HTMLButtonElement>('[data-mascot-next]');
  const avatarTrack = dialog.querySelector<HTMLElement>('[data-mascot-avatars]')!;
  const currentName = dialog.querySelector<HTMLElement>('[data-mascot-current-name]')!;

  type MascotItem = {
    card: HTMLElement;
    id: string;
    name: string;
    avatarSrc: string;
    previewSrc: string;
  };

  let scale = 1;
  let translateX = 0;
  let translateY = 0;
  let activeMascots: MascotItem[] = [];
  let currentIndex = -1;
  const MIN_SCALE = 1;
  const MAX_SCALE = 5;

  const pointers = new Map<number, { x: number; y: number }>();
  let prevPinchDist = 0;
  let prevPinchCenter = { x: 0, y: 0 };
  let isDragging = false;
  let dragMoved = false;
  let gestureStart: { pointerId: number; x: number; y: number; pointerType: string } | null = null;
  let gestureWasPinch = false;
  let swipeTranslateX = 0;
  let swipeIntent: 'undecided' | 'horizontal' | 'vertical' = 'undecided';
  let isSwipingMascot = false;

  function resetSwipeState() {
    swipeTranslateX = 0;
    swipeIntent = 'undecided';
    isSwipingMascot = false;
  }

  function getResistedSwipeOffset(offset: number) {
    const hasPrevious = currentIndex > 0;
    const hasNext = currentIndex >= 0 && currentIndex < activeMascots.length - 1;
    if ((offset > 0 && !hasPrevious) || (offset < 0 && !hasNext)) {
      return offset * 0.32;
    }
    return offset;
  }

  function applySwipeTransform(offset: number) {
    swipeTranslateX = getResistedSwipeOffset(offset);
    isSwipingMascot = true;
    img.style.transition = 'none';
    img.style.transform = `translate3d(${Math.round(swipeTranslateX * 10) / 10}px, 0, 0) scale(1)`;
  }

  function snapSwipeBack() {
    scale = 1;
    translateX = 0;
    translateY = 0;
    img.style.transition = 'transform 0.24s cubic-bezier(0.16, 1, 0.3, 1)';
    img.style.transform = 'translate3d(0, 0, 0) scale(1)';
    resetSwipeState();
  }

  function readMascot(card: HTMLElement): MascotItem | null {
    const zoom = card.querySelector<HTMLButtonElement>('[data-mascot-zoom]');
    const selectable = card.querySelector<HTMLElement>('[data-mascot-select], [data-mascot-check]');
    const frontImg = card.querySelector<HTMLImageElement>('.mascot-face-front img');
    const backImg = card.querySelector<HTMLImageElement>('.mascot-face-back img');
    const name = zoom?.dataset.mascotName ?? selectable?.dataset.mascotName ?? frontImg?.alt ?? '';
    const avatarSrc = frontImg?.src ?? '';
    const previewSrc = backImg?.src ?? avatarSrc;

    if (!name || !avatarSrc || !previewSrc) return null;

    return {
      card,
      id: selectable?.dataset.mascotId ?? name,
      name,
      avatarSrc,
      previewSrc,
    };
  }

  function getVisibleMascots() {
    return Array.from(document.querySelectorAll<HTMLElement>('[data-mascot-card]'))
      .filter((card) => getComputedStyle(card).display !== 'none')
      .map(readMascot)
      .filter((mascot): mascot is MascotItem => Boolean(mascot));
  }

  function setButtonState(button: HTMLButtonElement | null, disabled: boolean, label: string) {
    if (!button) return;
    button.disabled = disabled;
    button.setAttribute('aria-label', label);
    button.title = label;
  }

  function renderCarousel() {
    avatarTrack.innerHTML = '';
    const currentMascot = activeMascots[currentIndex];
    if (!currentMascot) {
      currentName.textContent = '';
      setButtonState(prevBtn, true, 'Predchádzajúci maskot');
      setButtonState(nextBtn, true, 'Ďalší maskot');
      return;
    }

    currentName.textContent = currentMascot.name;

    const previousMascot = activeMascots[currentIndex - 1];
    const nextMascot = activeMascots[currentIndex + 1];
    setButtonState(prevBtn, !previousMascot, previousMascot ? `Predchádzajúci maskot: ${previousMascot.name}` : 'Predchádzajúci maskot');
    setButtonState(nextBtn, !nextMascot, nextMascot ? `Ďalší maskot: ${nextMascot.name}` : 'Ďalší maskot');

    const start = Math.max(0, currentIndex - 2);
    const end = Math.min(activeMascots.length - 1, currentIndex + 2);

    for (let index = start; index <= end; index += 1) {
      const mascot = activeMascots[index];
      const offset = index - currentIndex;
      const button = document.createElement('button');
      const frame = document.createElement('span');
      const avatar = document.createElement('img');
      const isCurrent = index === currentIndex;

      button.type = 'button';
      button.className = `mascot-orbit-item${isCurrent ? ' is-current' : ''}`;
      button.dataset.offset = String(offset);
      button.dataset.mascotUi = '';
      button.setAttribute('aria-label', isCurrent ? `${mascot.name} je otvorený` : `Zobraziť maskota ${mascot.name}`);
      if (isCurrent) {
        button.setAttribute('aria-current', 'true');
      }
      button.addEventListener('click', () => {
        if (index === currentIndex) return;
        showMascot(index, index > currentIndex ? 1 : -1);
      });

      frame.className = 'mascot-orbit-frame';
      avatar.src = mascot.avatarSrc;
      avatar.alt = '';
      avatar.loading = 'lazy';
      avatar.draggable = false;

      frame.appendChild(avatar);
      button.appendChild(frame);
      avatarTrack.appendChild(button);
    }
  }

  function showMascot(index: number, direction = 0) {
    const mascot = activeMascots[index];
    if (!mascot) return;

    currentIndex = index;
    scale = 1;
    translateX = 0;
    translateY = 0;
    isDragging = false;
    dragMoved = false;
    pointers.clear();
    prevPinchDist = 0;
    gestureStart = null;
    gestureWasPinch = false;
    resetSwipeState();

    img.alt = mascot.name;
    img.src = mascot.previewSrc;
    if (zoomLevel) zoomLevel.textContent = '100%';
    viewport.style.cursor = 'default';

    if (direction !== 0) {
      const startX = direction > 0 ? 110 : -110;
      img.style.transition = 'none';
      img.style.transform = `translate3d(${startX}px, 0, 0) scale(1)`;
      requestAnimationFrame(() => {
        img.style.transition = 'transform 0.34s cubic-bezier(0.16, 1, 0.3, 1)';
        img.style.transform = 'translate3d(0, 0, 0) scale(1)';
      });
    } else {
      clampAndApply(false);
    }

    renderCarousel();
  }

  function openMascot(card: HTMLElement) {
    activeMascots = getVisibleMascots();
    const index = activeMascots.findIndex((mascot) => mascot.card === card);
    if (index < 0) return;

    showMascot(index, 0);
    dialog.showModal();
  }

  function navigateMascot(delta: number) {
    if (scale > 1.001) return;
    const nextIndex = currentIndex + delta;
    if (nextIndex < 0 || nextIndex >= activeMascots.length) return;
    showMascot(nextIndex, delta > 0 ? 1 : -1);
  }

  function clampAndApply(animate = false) {
    if (scale <= 1.001) {
      scale = 1;
      translateX = 0;
      translateY = 0;
    } else {
      const vRect = viewport.getBoundingClientRect();
      const naturalW = img.offsetWidth || vRect.width;
      const naturalH = img.offsetHeight || vRect.height;
      const scaledW = naturalW * scale;
      const scaledH = naturalH * scale;

      const maxPanX = Math.max(0, (scaledW - vRect.width) / 2 + 50);
      const maxPanY = Math.max(0, (scaledH - vRect.height) / 2 + 50);

      translateX = Math.max(-maxPanX, Math.min(maxPanX, translateX));
      translateY = Math.max(-maxPanY, Math.min(maxPanY, translateY));
    }

    if (animate) {
      img.style.transition = 'transform 0.2s cubic-bezier(0.16, 1, 0.3, 1)';
    } else {
      img.style.transition = 'none';
    }

    img.style.transform = `translate3d(${Math.round(translateX * 10) / 10}px, ${Math.round(translateY * 10) / 10}px, 0) scale(${scale})`;

    if (zoomLevel) {
      zoomLevel.textContent = `${Math.round(scale * 100)}%`;
    }
    viewport.style.cursor = scale > 1 ? (isDragging ? 'grabbing' : 'grab') : 'default';
  }

  function zoomAround(factor: number, clientX?: number, clientY?: number, animate = false) {
    const vRect = viewport.getBoundingClientRect();
    const focusX = clientX !== undefined ? clientX - (vRect.left + vRect.width / 2) : 0;
    const focusY = clientY !== undefined ? clientY - (vRect.top + vRect.height / 2) : 0;

    const targetScale = Math.min(Math.max(MIN_SCALE, scale * factor), MAX_SCALE);
    if (Math.abs(targetScale - scale) < 0.001) return;

    if (targetScale <= 1) {
      scale = 1;
      translateX = 0;
      translateY = 0;
    } else {
      const pointX = (focusX - translateX) / scale;
      const pointY = (focusY - translateY) / scale;
      scale = targetScale;
      translateX = focusX - pointX * scale;
      translateY = focusY - pointY * scale;
    }
    clampAndApply(animate);
  }

  function resetZoom(animate = false) {
    scale = 1;
    translateX = 0;
    translateY = 0;
    resetSwipeState();
    clampAndApply(animate);
  }

  // Mouse wheel scroll to zoom
  viewport.addEventListener('wheel', (e) => {
    e.preventDefault();
    const zoomFactor = e.deltaY < 0 ? 1.18 : 1 / 1.18;
    zoomAround(zoomFactor, e.clientX, e.clientY, false);
  }, { passive: false });

  // Pointer events (Pan on PC & Pinch-to-zoom on touch devices)
  viewport.addEventListener('pointerdown', (e) => {
    if ((e.target as Element | null)?.closest('[data-mascot-ui]')) return;
    if (e.button !== 0 && e.pointerType === 'mouse') return;
    viewport.setPointerCapture(e.pointerId);
    if (pointers.size === 0) {
      gestureStart = { pointerId: e.pointerId, x: e.clientX, y: e.clientY, pointerType: e.pointerType };
      gestureWasPinch = false;
    }
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    isDragging = true;
    dragMoved = false;
    resetSwipeState();

    if (pointers.size === 2) {
      gestureWasPinch = true;
      resetSwipeState();
      const [p1, p2] = Array.from(pointers.values());
      prevPinchDist = Math.hypot(p2.x - p1.x, p2.y - p1.y);
      prevPinchCenter = { x: (p1.x + p2.x) / 2, y: (p1.y + p2.y) / 2 };
    }
    clampAndApply(false);
  });

  viewport.addEventListener('pointermove', (e) => {
    if (!pointers.has(e.pointerId)) return;

    if (pointers.size === 1) {
      const prev = pointers.get(e.pointerId)!;
      const dx = e.clientX - prev.x;
      const dy = e.clientY - prev.y;
      const totalDx = gestureStart?.pointerId === e.pointerId ? e.clientX - gestureStart.x : 0;
      const totalDy = gestureStart?.pointerId === e.pointerId ? e.clientY - gestureStart.y : 0;
      if (Math.abs(dx) > 3 || Math.abs(dy) > 3) {
        dragMoved = true;
      }
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (scale > 1) {
        resetSwipeState();
        translateX += dx;
        translateY += dy;
        clampAndApply(false);
      } else if (gestureStart?.pointerId === e.pointerId && gestureStart.pointerType !== 'mouse' && !gestureWasPinch && scale <= 1.001) {
        const absX = Math.abs(totalDx);
        const absY = Math.abs(totalDy);
        if (swipeIntent === 'undecided' && (absX > 8 || absY > 8)) {
          swipeIntent = absX > absY * 1.15 ? 'horizontal' : 'vertical';
        }
        if (swipeIntent === 'horizontal') {
          applySwipeTransform(totalDx);
        }
      }
    } else if (pointers.size === 2) {
      dragMoved = true;
      resetSwipeState();
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      const [p1, p2] = Array.from(pointers.values());
      const dist = Math.hypot(p2.x - p1.x, p2.y - p1.y);
      const center = { x: (p1.x + p2.x) / 2, y: (p1.y + p2.y) / 2 };

      if (prevPinchDist > 0 && dist > 0) {
        const factor = dist / prevPinchDist;
        zoomAround(factor, center.x, center.y, false);
        translateX += center.x - prevPinchCenter.x;
        translateY += center.y - prevPinchCenter.y;
        clampAndApply(false);
      }
      prevPinchDist = dist;
      prevPinchCenter = center;
    }
  });

  const handlePointerEnd = (e: PointerEvent) => {
    let navigatedBySwipe = false;

    if (pointers.has(e.pointerId)) {
      pointers.delete(e.pointerId);
      try {
        viewport.releasePointerCapture(e.pointerId);
      } catch {}
    }
    if (pointers.size < 2) {
      prevPinchDist = 0;
    }
    if (pointers.size === 0) {
      isDragging = false;
      if (gestureStart?.pointerId === e.pointerId && gestureStart.pointerType !== 'mouse' && !gestureWasPinch && scale <= 1.001) {
        const dx = e.clientX - gestureStart.x;
        const dy = e.clientY - gestureStart.y;
        const threshold = Math.min(72, viewport.clientWidth * 0.2);
        const canNavigate = dx < 0 ? currentIndex < activeMascots.length - 1 : currentIndex > 0;
        if (Math.abs(dx) >= threshold && Math.abs(dy) <= 80 && canNavigate) {
          navigateMascot(dx < 0 ? 1 : -1);
          navigatedBySwipe = true;
        }
      }
      gestureStart = null;
      gestureWasPinch = false;
      if (!navigatedBySwipe && isSwipingMascot) {
        snapSwipeBack();
      } else if (!navigatedBySwipe) {
        clampAndApply(true);
      }
    }
  };

  viewport.addEventListener('pointerup', handlePointerEnd);
  viewport.addEventListener('pointercancel', handlePointerEnd);

  // Double click / Double tap to quickly zoom in / reset
  viewport.addEventListener('dblclick', (e) => {
    if (scale > 1.1) {
      resetZoom(true);
    } else {
      zoomAround(2.5, e.clientX, e.clientY, true);
    }
  });

  // Zoom control buttons
  zoomInBtn?.addEventListener('click', () => zoomAround(1.35, undefined, undefined, true));
  zoomOutBtn?.addEventListener('click', () => zoomAround(1 / 1.35, undefined, undefined, true));
  zoomResetBtn?.addEventListener('click', () => resetZoom(true));
  prevBtn?.addEventListener('click', () => navigateMascot(-1));
  nextBtn?.addEventListener('click', () => navigateMascot(1));

  // Open mascot preview dialog — always prefer the real photo over the illustration
  document.querySelectorAll<HTMLButtonElement>('[data-mascot-zoom]').forEach((zoom) => {
    zoom.addEventListener('click', () => {
      const card = zoom.closest('[data-mascot-card]')!;
      openMascot(card as HTMLElement);
    });
  });

  // Close handlers
  closeBtn?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => {
    activeMascots = [];
    currentIndex = -1;
    avatarTrack.innerHTML = '';
    currentName.textContent = '';
    resetZoom(false);
  });

  // Keyboard controls
  document.addEventListener('keydown', (e) => {
    if (!dialog.open) return;

    if (e.key === '+' || e.key === '=') {
      e.preventDefault();
      zoomAround(1.3, undefined, undefined, true);
    } else if (e.key === '-' || e.key === '_') {
      e.preventDefault();
      zoomAround(1 / 1.3, undefined, undefined, true);
    } else if (e.key === '0') {
      e.preventDefault();
      resetZoom(true);
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      navigateMascot(-1);
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      navigateMascot(1);
    }
  });
</script>

<style is:global>
  .mascot-orbit-item {
    --orbit-x: 0rem;
    --orbit-y: 0rem;
    --orbit-scale: 1;
    --orbit-z: 1;
    position: absolute;
    left: 50%;
    top: 0;
    z-index: var(--orbit-z);
    display: flex;
    height: 4.65rem;
    width: 4.65rem;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 999px;
    background: transparent;
    padding: 0;
    cursor: pointer;
    transform: translate(calc(-50% + var(--orbit-x)), var(--orbit-y)) scale(var(--orbit-scale));
    transition: transform 0.34s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.24s ease;
  }

  .mascot-orbit-item[data-offset='-2'] {
    --orbit-x: -12.8rem;
    --orbit-y: 3.75rem;
    --orbit-scale: 0.78;
  }

  .mascot-orbit-item[data-offset='-1'] {
    --orbit-x: -6.5rem;
    --orbit-y: 1.85rem;
    --orbit-scale: 0.94;
    --orbit-z: 2;
  }

  .mascot-orbit-item[data-offset='0'] {
    --orbit-y: -0.85rem;
    --orbit-scale: 1;
    --orbit-z: 4;
  }

  .mascot-orbit-item[data-offset='1'] {
    --orbit-x: 6.5rem;
    --orbit-y: 1.85rem;
    --orbit-scale: 0.94;
    --orbit-z: 2;
  }

  .mascot-orbit-item[data-offset='2'] {
    --orbit-x: 12.8rem;
    --orbit-y: 3.75rem;
    --orbit-scale: 0.78;
  }

  .mascot-orbit-frame {
    display: block;
