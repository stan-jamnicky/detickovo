---
import { getFacebookPostEmbedSrc, getFacebookPostHref } from '../lib/facebook';

export interface EventPost {
  id?: string;
  eventType: string;
  facebookPostUrl: string;
  facebookEmbedHeight?: number;
}

interface Props {
  event: EventPost;
  index?: number;
}
const { event, index = 0 } = Astro.props;
const { facebookPostUrl, facebookEmbedHeight = 560 } = event;
const facebookHref = getFacebookPostHref(facebookPostUrl);
const facebookEmbedSrc = getFacebookPostEmbedSrc(facebookPostUrl);
---

<article class="relative mx-auto max-w-[350px] overflow-hidden rounded-blob bg-white shadow-lg shadow-ink/5 ring-1 ring-ink/5">
  <iframe
    src={facebookEmbedSrc}
    width="350"
    height={facebookEmbedHeight}
    title={`Facebook príspevok ${index + 1}`}
    style="border:none;overflow:hidden"
    scrolling="no"
    frameborder="0"
    allowfullscreen="true"
    allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
    class="block w-full max-w-full bg-cream"
    loading="lazy"
  ></iframe>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-white to-white/0" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 flex justify-center p-4">
    <a href={facebookHref} target="_blank" rel="noopener" class="btn-primary !px-5 !py-2.5 text-sm shadow-lg shadow-ink/10">Celý príspevok</a>
  </div>
</article>
