---
import type { CollectionEntry } from 'astro:content';
import { eventTypeLabel } from '../lib/eventTypes';

interface Props {
  event: CollectionEntry<'events'>;
}
const { event } = Astro.props;
const { title, cover, location, childrenCount, eventType, services } = event.data;
---

<a
  href={`/akcie/${event.id}/`}
  class="group flex flex-col overflow-hidden rounded-blob bg-white ring-1 ring-ink/5 transition-shadow hover:shadow-xl hover:shadow-ink/10"
>
  <div class="aspect-[3/2] overflow-hidden">
    <img
      src={cover}
      alt={title}
      width="1200"
      height="800"
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
    />
  </div>
  <div class="flex flex-1 flex-col gap-3 p-6">
    <p class="text-xs font-bold uppercase tracking-widest text-brand-blue">{eventTypeLabel(eventType)}</p>
    <h3 class="text-xl">{title}</h3>
    <p class="text-sm text-muted">{location} · {childrenCount} detí</p>
    <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
      {services.slice(0, 3).map((s) => <span class="chip !text-xs capitalize">{s.replace(/-/g, ' ')}</span>)}
      {services.length > 3 && <span class="chip !text-xs">+{services.length - 3}</span>}
    </div>
  </div>
</a>
