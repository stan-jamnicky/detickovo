---
import site from '../data/site.json';

const nav = [
  { href: '/velke-akcie', label: 'Veľké akcie' },
  { href: '/narodeniny', label: 'Narodeniny' },
  { href: '/svadby', label: 'Svadby' },
  { href: '/akcie', label: 'Naše akcie' },
  { href: '/kontakt', label: 'Kontakt' },
];
const current = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-ink/5 bg-white/90 backdrop-blur">
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 font-display text-xl font-extrabold tracking-tight">
      <svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden="true">
        <circle cx="7" cy="9" r="4" fill="#00adee" />
        <circle cx="16" cy="7" r="2.5" fill="#fbb02f" />
        <circle cx="17" cy="16" r="3.5" fill="#70be44" />
        <circle cx="8" cy="17" r="2" fill="#ed2d28" />
      </svg>
      {site.name}
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Hlavná navigácia">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'font-medium text-sm transition-colors hover:text-brand-blue',
            current.startsWith(item.href) ? 'text-brand-blue' : 'text-ink',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a href="/objednavka" class="btn-primary !px-5 !py-2.5 text-sm">Naplánovať akciu</a>
    </nav>

    <button
      id="menu-toggle"
      class="flex h-10 w-10 items-center justify-center rounded-full text-ink hover:bg-sand lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Otvoriť menu"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-ink/5 bg-white lg:hidden">
    <nav class="container-site flex flex-col gap-1 py-4" aria-label="Mobilná navigácia">
      {nav.map((item) => (
        <a href={item.href} class="rounded-xl px-3 py-3 font-medium hover:bg-sand">{item.label}</a>
      ))}
      <a href="/objednavka" class="btn-primary mt-2">Naplánovať akciu</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
