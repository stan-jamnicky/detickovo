---
import site from '../data/site.json';

const nav = [
  { href: '/velke-akcie', label: 'Veľké akcie' },
  { href: '/pobytove-tabory', label: 'Pobytové tábory' },
  { href: '/narodeniny', label: 'Narodeniny' },
  { href: '/svadby', label: 'Svadby' },
  { href: '/akcie', label: 'Naše akcie' },
  { href: '/maskoti', label: 'Maskoti' },
];
const current = Astro.url.pathname;
---

<header id="site-header" class="sticky top-0 z-40 border-b backdrop-blur transition-colors duration-300">
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center">
      <img src="/logo_2026.png" alt="Detičkovo" class="h-7 w-auto" width="615" height="108" />
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Hlavná navigácia">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'font-medium text-sm transition-colors hover:text-brand-blue',
            current.startsWith(item.href) ? 'text-brand-blue' : 'text-ink',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a href="/objednavka" class="btn-primary !px-5 !py-2.5 text-sm">Naplánovať akciu</a>
    </nav>

    <button
      id="menu-toggle"
      class="flex h-10 w-10 items-center justify-center rounded-full text-ink hover:bg-sand lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Otvoriť menu"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>
</header>

<div id="mobile-menu" class="invisible fixed inset-0 z-50 flex flex-col bg-cream opacity-0 transition-all duration-300 lg:hidden">
  <div class="container-site flex h-16 shrink-0 items-center justify-between">
    <a href="/" class="flex items-center">
      <img src="/logo_2026.png" alt="Detičkovo" class="h-7 w-auto" width="615" height="108" />
    </a>
    <button
      id="menu-close"
      class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-ink shadow-sm"
      aria-label="Zavrieť menu"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>
  <nav
    id="mobile-menu-nav"
    class="container-site flex flex-1 translate-y-4 flex-col justify-center transition-transform duration-300"
    aria-label="Mobilná navigácia"
  >
    {nav.map((item, i) => (
      <a
        href={item.href}
        class:list={[
          'flex items-center justify-between border-b border-ink/5 py-4 font-display text-3xl font-bold',
          current.startsWith(item.href) ? 'text-brand-blue' : 'text-ink',
        ]}
      >
        {item.label}
        <span class={['text-brand-blue', 'text-brand-green', 'text-brand-magenta', 'text-brand-orange', 'text-brand-red'][i % 5]} aria-hidden="true">→</span>
      </a>
    ))}
  </nav>
  <div class="container-site shrink-0 pb-10">
    <a href="/objednavka" class="btn-primary w-full">Naplánovať akciu</a>
  </div>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const menuNav = document.getElementById('mobile-menu-nav');
  const close = document.getElementById('menu-close');

  const setMenu = (open: boolean) => {
    menu?.classList.toggle('invisible', !open);
    menu?.classList.toggle('opacity-0', !open);
    menuNav?.classList.toggle('translate-y-4', !open);
    document.body.classList.toggle('overflow-hidden', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };
  toggle?.addEventListener('click', () => setMenu(true));
  close?.addEventListener('click', () => setMenu(false));

  const header = document.getElementById('site-header');
  const onScroll = () => {
    header?.toggleAttribute('data-scrolled', window.scrollY > 4);
  };
  onScroll();
  document.addEventListener('scroll', onScroll, { passive: true });
</script>
