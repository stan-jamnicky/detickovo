---
import { EVENT_TYPES } from '../lib/eventTypes';
---

<div class="grid grid-cols-2 gap-4 md:grid-cols-3">
  {EVENT_TYPES.map((type) => (
    <a
      href={type.href}
      class="group relative overflow-hidden rounded-blob bg-white p-6 ring-1 ring-ink/5 transition-shadow hover:shadow-lg hover:shadow-ink/10"
    >
      <span
        class="absolute -right-4 -top-4 h-16 w-16 rounded-full opacity-15 transition-transform group-hover:scale-125"
        style={`background:${type.color}`}
      ></span>
      <span class="mb-2 flex items-center gap-2">
        <span class="text-2xl" aria-hidden="true">{type.icon}</span>
        <span class="h-2.5 w-2.5 rounded-full" style={`background:${type.color}`}></span>
      </span>
      <h3 class="text-lg">{type.label}</h3>
      <p class="mt-1.5 hidden text-sm text-muted sm:block">{type.short}</p>
      <span class="mt-3 inline-block text-sm font-semibold text-brand-blue">Zistiť viac →</span>
    </a>
  ))}
</div>
