---
import site from '../data/site.json';

const colors = ['text-brand-blue', 'text-brand-green', 'text-brand-magenta', 'text-brand-orange'];
---

<div class="grid grid-cols-2 gap-8 lg:grid-cols-4">
  {site.stats.map((stat, i) => (
    <div class="text-center">
      <p class={`font-display text-4xl font-extrabold sm:text-5xl ${colors[i % colors.length]}`}>{stat.value}</p>
      <p class="mt-2 text-sm font-medium text-muted">{stat.label}</p>
    </div>
  ))}
</div>
