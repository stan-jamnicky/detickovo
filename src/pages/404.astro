---
import Base from '../layouts/Base.astro';
---

<Base title="Stránka sa nenašla – Detičkovo" description="Stránka, ktorú hľadáte, neexistuje.">
  <section class="section">
    <div class="container-site py-20 text-center">
      <p class="font-display text-7xl font-extrabold text-brand-blue">404</p>
      <h1 class="mt-4 text-3xl">Túto stránku sme nenašli</h1>
      <p class="mx-auto mt-3 max-w-md text-muted">Možno sa presunula, tak ako my z kaviarne priamo na vaše akcie.</p>
      <div class="mt-8 flex justify-center gap-3">
        <a href="/" class="btn-primary">Späť na úvod</a>
        <a href="/akcie" class="btn-secondary">Naše akcie</a>
      </div>
    </div>
  </section>
</Base>
