---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { EVENT_TYPES } from '../../lib/eventTypes';
import SocialIcons from '../../components/SocialIcons.astro';
import site from '../../data/site.json';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const mascots = (await getCollection('mascots')).sort((a, b) => a.data.order - b.data.order);
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? 'REPLACE_WITH_WEB3FORMS_KEY';

const MASCOT_CATEGORIES = [
  { id: 'labkova-patrola', label: 'Labková patrola' },
  { id: 'ladove-kralovstvo', label: 'Ľadové kráľovstvo' },
  { id: 'superhrdinovia', label: 'Superhrdinovia' },
  { id: 'disney', label: 'Disney' },
  { id: 'ostatni', label: 'A ďalší' },
].filter((c) => mascots.some((m) => m.data.category === c.id));

const childrenOptions = ['do 15 detí', '15 – 50 detí', '50 – 150 detí', '150 – 500 detí', 'viac ako 500 detí'];
---

<Base
  title="Naplánovať akciu – Detičkovo"
  description="Pošlite nám nezáväznú objednávku detského programu. Do 24 hodín sa ozveme s návrhom programu a dostupnosťou termínu."
>
  <section class="bg-cream">
    <div class="container-site pb-24 pt-14 sm:pt-16">
      <span class="kicker">Nezáväzná objednávka</span>
      <h1 class="max-w-2xl text-4xl sm:text-6xl">Naplánujme vašu akciu</h1>
      <p class="mt-4 max-w-xl text-muted">Tri krátke kroky. Do 24 hodín dostanete odpoveď s návrhom programu a cenovou ponukou.</p>
    </div>
  </section>

  <!-- Contact boxes straddling the hero edge -->
  <div class="container-site relative z-10 -mt-12">
    <div class="grid gap-5 sm:grid-cols-3">
      <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="rounded-blob bg-white p-6 shadow-lg shadow-ink/5 ring-1 ring-ink/5 transition-shadow hover:shadow-xl">
        <p class="text-xs font-bold uppercase tracking-widest text-brand-blue">Telefón</p>
        <p class="mt-1.5 font-display text-lg font-bold">{site.phoneDisplay}</p>
        <p class="mt-1 text-sm text-muted">Po–Pia 9:00–17:00</p>
      </a>
      <a href={`mailto:${site.email}`} class="rounded-blob bg-white p-6 shadow-lg shadow-ink/5 ring-1 ring-ink/5 transition-shadow hover:shadow-xl">
        <p class="text-xs font-bold uppercase tracking-widest text-brand-green">E-mail</p>
        <p class="mt-1.5 font-display text-lg font-bold">{site.email}</p>
        <p class="mt-1 text-sm text-muted">Odpovedáme do 24 hodín</p>
      </a>
      <div class="rounded-blob bg-white p-6 shadow-lg shadow-ink/5 ring-1 ring-ink/5">
        <p class="text-xs font-bold uppercase tracking-widest text-brand-magenta">Pôsobnosť</p>
        <p class="mt-1.5 font-display text-lg font-bold">{site.city}</p>
        <SocialIcons class="mt-2 text-brand-blue" />
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container-site max-w-3xl">
      <ol class="mb-10 flex items-center gap-2 text-sm font-semibold" data-progress>
        <li class="flex items-center gap-2" data-progress-step="1">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-blue text-white">1</span>
          <span class="hidden sm:inline">Akcia</span>
        </li>
        <li class="h-px flex-1 bg-ink/15" aria-hidden="true"></li>
        <li class="flex items-center gap-2 opacity-40" data-progress-step="2">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-sand">2</span>
          <span class="hidden sm:inline">Požiadavky</span>
        </li>
        <li class="h-px flex-1 bg-ink/15" aria-hidden="true"></li>
        <li class="flex items-center gap-2 opacity-40" data-progress-step="3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-sand">3</span>
          <span class="hidden sm:inline">Kontakt</span>
        </li>
      </ol>

      <form id="inquiry" action="https://api.web3forms.com/submit" method="POST" class="space-y-10">
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value="Nová nezáväzná objednávka z webu Detičkovo" />
        <input type="hidden" name="from_name" value="detickovocafe.sk" />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

        <fieldset data-step="1">
          <legend class="mb-6 font-display text-2xl font-bold">Čo pripravujete?</legend>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3" role="radiogroup" aria-label="Typ akcie">
            {EVENT_TYPES.map((type) => (
              <label class="flex cursor-pointer flex-col items-center gap-2 rounded-2xl bg-cream p-5 text-center ring-2 ring-transparent transition has-checked:bg-brand-blue has-checked:text-white has-focus-visible:ring-ink/40 hover:ring-brand-blue/40">
                <input type="radio" name="Typ akcie" value={type.label} data-type-id={type.id} required class="sr-only" />
                <span class="text-4xl" aria-hidden="true">{type.icon}</span>
                <span class="text-sm font-semibold">{type.label}</span>
              </label>
            ))}
          </div>
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1.5 block text-sm font-semibold">Dátum akcie</span>
              <input
                type="date"
                name="Dátum"
                id="datum"
                required
                placeholder="Vyberte dátum…"
                class="w-full rounded-xl border border-ink/15 bg-white px-4 py-3 focus:border-brand-blue focus:outline-none"
              />
            </label>
            <label class="block">
              <span class="mb-1.5 block text-sm font-semibold">Čas (približne)</span>
              <input type="text" name="Čas" placeholder="napr. 14:00 – 18:00" class="w-full rounded-xl border border-ink/15 px-4 py-3 focus:border-brand-blue focus:outline-none" />
            </label>
            <label class="block">
              <span class="mb-1.5 block text-sm font-semibold">Miesto akcie</span>
              <div class="relative">
                <input
                  type="text"
                  name="Miesto"
                  id="miesto"
                  required
                  placeholder="mesto, obec alebo adresa"
                  autocomplete="off"
                  role="combobox"
                  aria-expanded="false"
                  aria-controls="miesto-list"
                  aria-autocomplete="list"
                  class="w-full rounded-xl border border-ink/15 px-4 py-3 focus:border-brand-blue focus:outline-none"
                />
                <span
                  id="miesto-spin"
                  class="pointer-events-none absolute right-3.5 top-1/2 hidden h-5 w-5 -translate-y-1/2 animate-spin rounded-full border-2 border-ink/15 border-t-brand-blue"
                  aria-hidden="true"
                ></span>
                <ul
                  id="miesto-list"
                  role="listbox"
                  aria-label="Návrhy adries"
                  class="invisible absolute z-10 mt-1 max-h-64 w-full -translate-y-1 overflow-auto rounded-xl border border-ink/10 bg-white py-1 opacity-0 shadow-lg shadow-ink/10 transition-all duration-150 ease-out"
                ></ul>
              </div>
            </label>
            <label class="block">
              <span class="mb-1.5 block text-sm font-semibold">Približný počet detí</span>
              <select name="Počet detí" required class="w-full rounded-xl border border-ink/15 bg-white px-4 py-3 focus:border-brand-blue focus:outline-none">
                <option value="" disabled selected>Vyberte…</option>
                {childrenOptions.map((o) => <option value={o}>{o}</option>)}
              </select>
            </label>
          </div>
        </fieldset>

        <fieldset data-step="2" hidden>
          <legend class="mb-6 font-display text-2xl font-bold">Čo by ste chceli v programe?</legend>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
            {services.map((s) => (
              <label class="flex cursor-pointer flex-col items-center gap-2 rounded-2xl bg-cream p-5 text-center ring-2 ring-transparent transition has-checked:bg-brand-blue has-checked:text-white has-focus-visible:ring-ink/40 hover:ring-brand-blue/40">
                <input type="checkbox" name="Služby" value={s.data.title} class="sr-only" />
                <span class="text-4xl" aria-hidden="true">{s.data.icon}</span>
                <span class="text-sm font-semibold">{s.data.title}</span>
                <span class="text-xs leading-snug opacity-70">{s.data.description}</span>
              </label>
            ))}
          </div>
          <div data-mascot-picker hidden class="mt-8">
            <p class="font-display text-lg font-bold">Vyberte maskotov <span class="font-sans text-sm font-normal text-muted">(minimálne 2)</span></p>
            <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Filter maskotov">
              <button type="button" class="chip !bg-ink !text-white" data-mascot-filter="all">Všetci</button>
              {MASCOT_CATEGORIES.map((c) => (
                <button type="button" class="chip hover:bg-ink/10" data-mascot-filter={c.id}>{c.label}</button>
              ))}
            </div>
            <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
              {mascots.map((m) => (
                <label
                  class="group cursor-pointer overflow-hidden rounded-2xl bg-white ring-2 ring-ink/10 transition has-checked:ring-brand-blue hover:ring-brand-blue/40"
                  data-mascot-card
                  data-mascot-category={m.data.category}
                >
                  <input type="checkbox" name="Maskoti" value={m.data.name} class="sr-only" data-mascot-check data-mascot-id={m.id} />
                  <img src={m.data.photo} alt={m.data.name} width="1200" height="800" loading="lazy" class="aspect-square w-full object-cover" />
                  <span class="block p-2 text-center text-xs font-semibold transition group-has-checked:bg-brand-blue group-has-checked:text-white">{m.data.name}</span>
                </label>
              ))}
            </div>
            <p data-mascot-error hidden class="mt-3 rounded-xl bg-brand-red/10 p-3 text-sm font-medium text-brand-red">
              Vyberte prosím aspoň 2 maskotov.
            </p>
          </div>
          <label class="mt-6 block">
            <span class="mb-1.5 block text-sm font-semibold">Iné požiadavky (nepovinné)</span>
            <textarea name="Iné požiadavky" rows="3" placeholder="Čokoľvek, čo by sme mali vedieť…" class="w-full rounded-xl border border-ink/15 px-4 py-3 focus:border-brand-blue focus:outline-none"></textarea>
          </label>
        </fieldset>

        <fieldset data-step="3" hidden>
          <legend class="mb-6 font-display text-2xl font-bold">Kam vám pošleme ponuku?</legend>
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1.5 block text-sm font-semibold">Meno a priezvisko</span>
              <input type="text" name="Meno" required autocomplete="name" class="w-full rounded-xl border border-ink/15 px-4 py-3 focus:border-brand-blue focus:outline-none" />
            </label>
            <label class="block">
              <span class="mb-1.5 block text-sm font-semibold">Telefón</span>
              <input type="tel" name="Telefón" required autocomplete="tel" class="w-full rounded-xl border border-ink/15 px-4 py-3 focus:border-brand-blue focus:outline-none" />
            </label>
            <label class="block sm:col-span-2">
              <span class="mb-1.5 block text-sm font-semibold">E-mail</span>
              <input type="email" name="email" required autocomplete="email" class="w-full rounded-xl border border-ink/15 px-4 py-3 focus:border-brand-blue focus:outline-none" />
            </label>
            <label class="block sm:col-span-2">
              <span class="mb-1.5 block text-sm font-semibold">Správa (nepovinné)</span>
              <textarea name="Správa" rows="3" class="w-full rounded-xl border border-ink/15 px-4 py-3 focus:border-brand-blue focus:outline-none"></textarea>
            </label>
            <label class="flex cursor-pointer items-start gap-3 sm:col-span-2">
              <input type="checkbox" name="GDPR súhlas" value="áno" required class="mt-1 accent-brand-blue" />
              <span class="text-sm text-muted">
                Súhlasím so spracovaním osobných údajov na účely vypracovania ponuky a komunikácie.
                Viac v <a href="/ochrana-sukromia" class="font-semibold text-brand-blue hover:underline">zásadách ochrany súkromia</a>.
              </span>
            </label>
          </div>
        </fieldset>

        <div class="flex items-center justify-between gap-3">
          <button type="button" data-prev hidden class="btn-secondary">← Späť</button>
          <button type="button" data-next class="btn-primary ml-auto">Pokračovať →</button>
          <button type="submit" data-submit hidden class="btn-primary ml-auto">Odoslať nezáväznú objednávku</button>
        </div>
        <p data-error hidden class="rounded-xl bg-brand-red/10 p-4 text-sm font-medium text-brand-red">
          Objednávku sa nepodarilo odoslať. Skúste to prosím znova alebo nám napíšte na info@detickovocafe.sk.
        </p>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('inquiry') as HTMLFormElement;
  const steps = [...form.querySelectorAll<HTMLFieldSetElement>('[data-step]')];
  const progress = [...document.querySelectorAll<HTMLElement>('[data-progress-step]')];
  const prevBtn = form.querySelector<HTMLButtonElement>('[data-prev]')!;
  const nextBtn = form.querySelector<HTMLButtonElement>('[data-next]')!;
  const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
  const errorBox = form.querySelector<HTMLElement>('[data-error]')!;
  let current = 0;

  // Pre-select event type from ?typ= query param
  const typ = new URLSearchParams(location.search).get('typ');
  if (typ) {
    form.querySelector<HTMLInputElement>(`input[data-type-id="${typ}"]`)?.click();
  }

  function show(i: number) {
    current = i;
    steps.forEach((s, idx) => (s.hidden = idx !== i));
    progress.forEach((p, idx) => p.classList.toggle('opacity-40', idx > i));
    prevBtn.hidden = i === 0;
    nextBtn.hidden = i === steps.length - 1;
    submitBtn.hidden = i !== steps.length - 1;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function stepValid(i: number) {
    const fields = steps[i].querySelectorAll<HTMLInputElement>('input, select, textarea');
    return [...fields].every((f) => f.reportValidity());
  }

  // Mascot picker: shown when the Maskoti service is checked; requires at least 2 picks
  const maskotiService = form.querySelector<HTMLInputElement>('input[name="Služby"][value="Maskoti"]');
  const mascotPicker = form.querySelector<HTMLElement>('[data-mascot-picker]')!;
  const mascotChecks = [...form.querySelectorAll<HTMLInputElement>('[data-mascot-check]')];
  const mascotError = form.querySelector<HTMLElement>('[data-mascot-error]')!;

  maskotiService?.addEventListener('change', () => {
    mascotPicker.hidden = !maskotiService.checked;
    if (!maskotiService.checked) {
      mascotChecks.forEach((c) => (c.checked = false));
      mascotError.hidden = true;
    }
  });

  function mascotsValid() {
    if (!maskotiService?.checked) return true;
    const ok = mascotChecks.filter((c) => c.checked).length >= 2;
    mascotError.hidden = ok;
    if (!ok) mascotPicker.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return ok;
  }

  // Pre-select mascots carried over from the narodeniny page (?maskoti=id1,id2)
  const mascotParam = new URLSearchParams(location.search).get('maskoti');
  if (mascotParam && maskotiService) {
    if (!maskotiService.checked) maskotiService.click();
    mascotParam.split(',').forEach((id) => {
      const check = form.querySelector<HTMLInputElement>(`[data-mascot-check][data-mascot-id="${CSS.escape(id)}"]`);
      if (check) check.checked = true;
    });
  }

  const mascotFilters = [...form.querySelectorAll<HTMLButtonElement>('[data-mascot-filter]')];
  const mascotCards = [...form.querySelectorAll<HTMLElement>('[data-mascot-card]')];
  mascotFilters.forEach((btn) => {
    btn.addEventListener('click', () => {
      mascotFilters.forEach((b) => b.classList.remove('!bg-ink', '!text-white'));
      btn.classList.add('!bg-ink', '!text-white');
      const filter = btn.dataset.mascotFilter;
      mascotCards.forEach((card) => {
        card.style.display = filter === 'all' || card.dataset.mascotCategory === filter ? '' : 'none';
      });
    });
  });

  prevBtn.addEventListener('click', () => show(current - 1));
  nextBtn.addEventListener('click', () => {
    if (stepValid(current) && (current !== 1 || mascotsValid())) show(current + 1);
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!stepValid(current) || !mascotsValid()) return;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Odosielam…';
    errorBox.hidden = true;
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      location.href = '/objednavka/dakujeme/';
    } catch {
      errorBox.hidden = false;
      submitBtn.disabled = false;
      submitBtn.textContent = 'Odoslať nezáväznú objednávku';
    }
  });
</script>

<script>
  // Address autocomplete via Photon (OpenStreetMap), biased to Slovakia's bounding box
  const input = document.getElementById('miesto') as HTMLInputElement;
  const list = document.getElementById('miesto-list') as HTMLUListElement;
  const spin = document.getElementById('miesto-spin') as HTMLElement;
  let timer: number | undefined;
  let active = -1;
  let ctrl: AbortController | null = null;
  let seq = 0;
  const cache = new Map<string, string[]>();

  const setOpen = (open: boolean) => {
    list.classList.toggle('invisible', !open);
    list.classList.toggle('opacity-0', !open);
    list.classList.toggle('-translate-y-1', !open);
    input.setAttribute('aria-expanded', String(open));
    if (!open) {
      active = -1;
      input.removeAttribute('aria-activedescendant');
    }
  };

  const pick = (label: string) => {
    input.value = label;
    setOpen(false);
  };

  const highlight = (i: number) => {
    const items = [...list.children] as HTMLElement[];
    if (!items.length) return;
    active = (i + items.length) % items.length;
    items.forEach((el, idx) => el.classList.toggle('bg-cream', idx === active));
    items[active].scrollIntoView({ block: 'nearest' });
    input.setAttribute('aria-activedescendant', items[active].id);
  };

  // Rebuilds options in place; previous results stay visible while a fetch is pending
  const render = (labels: string[], q: string) => {
    list.innerHTML = '';
    labels.forEach((label, idx) => {
      const li = document.createElement('li');
      li.id = `miesto-opt-${idx}`;
      li.setAttribute('role', 'option');
      li.className = 'cursor-pointer px-4 py-2.5 text-sm hover:bg-cream';
      const at = label.toLowerCase().indexOf(q.toLowerCase());
      if (at >= 0) {
        const strong = document.createElement('strong');
        strong.textContent = label.slice(at, at + q.length);
        li.append(label.slice(0, at), strong, label.slice(at + q.length));
      } else {
        li.textContent = label;
      }
      li.addEventListener('mousedown', (e) => {
        e.preventDefault();
        pick(label);
      });
      list.appendChild(li);
    });
    setOpen(labels.length > 0);
  };

  input.addEventListener('input', () => {
    clearTimeout(timer);
    const q = input.value.trim();
    if (q.length < 3) {
      ctrl?.abort();
      spin.classList.add('hidden');
      return setOpen(false);
    }
    const cached = cache.get(q);
    if (cached) return render(cached, q);
    timer = window.setTimeout(async () => {
      ctrl?.abort();
      ctrl = new AbortController();
      const mySeq = ++seq;
      spin.classList.remove('hidden');
      try {
        const res = await fetch(
          `https://photon.komoot.io/api/?q=${encodeURIComponent(q)}&limit=5&bbox=16.8,47.7,22.6,49.7`,
          { signal: ctrl.signal }
        );
        if (!res.ok || mySeq !== seq) return;
        const data = await res.json();
        const labels: string[] = [
          ...new Set<string>(
            data.features.map((f: any) => {
              const p = f.properties;
              const street = p.street && p.housenumber ? `${p.street} ${p.housenumber}` : p.street;
              return [p.name, street, p.city ?? p.county, p.postcode].filter(Boolean).join(', ');
            })
          ),
        ];
        cache.set(q, labels);
        if (mySeq === seq && input.value.trim() === q) render(labels, q);
      } catch {
        /* aborted or offline – keep whatever is shown */
      } finally {
        if (mySeq === seq) spin.classList.add('hidden');
      }
    }, 250);
  });

  input.addEventListener('keydown', (e) => {
    if (list.classList.contains('invisible')) return;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      highlight(active + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      highlight(active - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      const item = list.children[active >= 0 ? active : 0] as HTMLElement | undefined;
      if (item) pick(item.textContent ?? '');
    } else if (e.key === 'Escape') {
      setOpen(false);
    }
  });

  input.addEventListener('blur', () => setTimeout(() => setOpen(false), 150));
</script>

<script>
  import flatpickr from 'flatpickr';
  import { Slovak } from 'flatpickr/dist/l10n/sk.js';

  flatpickr('#datum', {
    locale: Slovak,
    minDate: 'today',
    dateFormat: 'd.m.Y',
    disableMobile: false,
  });
</script>

<style is:global>
  @import 'flatpickr/dist/flatpickr.css';

  .flatpickr-calendar {
    border-radius: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 8%, transparent);
    box-shadow: 0 20px 40px -12px color-mix(in srgb, var(--color-ink) 20%, transparent);
    font-family: var(--font-sans);
    padding: 0.5rem;
    width: auto;
  }
  .flatpickr-calendar.arrowTop::before,
  .flatpickr-calendar.arrowTop::after,
  .flatpickr-calendar.arrowBottom::before,
  .flatpickr-calendar.arrowBottom::after {
    display: none;
  }
  .flatpickr-months .flatpickr-month,
  .flatpickr-current-month .flatpickr-monthDropdown-months {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink);
  }
  .flatpickr-months .flatpickr-prev-month,
  .flatpickr-months .flatpickr-next-month {
    fill: var(--color-ink);
    border-radius: 9999px;
    top: 0.4rem;
  }
  .flatpickr-months .flatpickr-prev-month:hover svg,
  .flatpickr-months .flatpickr-next-month:hover svg {
    fill: var(--color-brand-blue);
  }
  span.flatpickr-weekday {
    color: var(--color-muted);
    font-weight: 600;
    text-transform: uppercase;
