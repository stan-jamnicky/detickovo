---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Confetti from '../components/Confetti.astro';
import EventTypeTiles from '../components/EventTypeTiles.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import EventCard from '../components/EventCard.astro';
import StatBand from '../components/StatBand.astro';
import ReferenceRow from '../components/ReferenceRow.astro';
import CTASection from '../components/CTASection.astro';

const events = (await getCollection('events')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = events.filter((e) => e.data.featured).slice(0, 3);
const recent = featured.length >= 3 ? featured : events.slice(0, 3);
const mascotTeaser = (await getCollection('mascots')).sort((a, b) => a.data.order - b.data.order).slice(0, 6);
---

<Base
  title="Detičkovo – Detský program a zábava na vašu akciu"
  description="Privezieme zábavu, odvezieme nudu. Maskoti, animátori a kompletný detský program pre mestá, školy, firmy, svadby aj narodeninové oslavy po celom Slovensku."
>
  <!-- Hero -->
  <section class="overflow-hidden bg-cream">
    <div class="relative mx-auto max-w-[100rem]">
      <img
        src="/hero_image_3_faded.png"
        alt=""
        aria-hidden="true"
        width="3344"
        height="1882"
        class="absolute top-1/2 hidden w-[55%] -translate-y-1/2 md:right-0 md:block lg:-right-[15%] lg:w-[75%]"
        fetchpriority="high"
      />
      <div class="container-site relative flex items-center pt-14 pb-0 sm:pt-16 md:min-h-[34rem] md:py-16 lg:min-h-[42rem] lg:py-20">
        <div class="relative mx-auto max-w-xl text-center md:mx-0 md:text-left">
          <Confetti class="absolute -top-10 left-1/2 w-20 -translate-x-1/2 sm:w-28 md:-top-16 md:left-0 md:w-32 md:translate-x-0" />
          <h1 class="text-4xl sm:text-6xl">Privezieme zábavu. Odvezieme nudu.</h1>
          <p class="mx-auto mt-5 max-w-lg text-lg text-muted md:mx-0">
            Maskoti, animátori a kompletný detský program pre mestá, školy, firmy, svadby aj oslavy.
            Vy organizujete, my zabávame.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-3 md:justify-start">
            <a href="/objednavka" class="btn-primary">Naplánovať akciu</a>
            <a href="/akcie" class="btn-secondary">Pozrieť naše akcie</a>
          </div>
        </div>
      </div>
    </div>
    <img
      src="/hero_image_3_faded.png"
      alt="Deti na akcii s animátormi a maskotmi Detičkova"
      width="3344"
      height="1882"
      class="relative -mb-[5%] -ml-[12.5%] w-[125%] max-w-none md:hidden"
      fetchpriority="high"
    />
  </section>

  <!-- Event type picker -->
  <section class="section">
    <div class="container-site">
      <span class="kicker">Kde budeme zabávať?</span>
      <h2 class="max-w-xl text-3xl sm:text-4xl">Akú akciu pripravujete?</h2>
      <div class="mt-10">
        <EventTypeTiles />
      </div>
    </div>
  </section>

  <!-- Large events -->
  <section class="section bg-cream">
    <div class="container-site grid items-center gap-10 lg:grid-cols-2">
      <div>
        <span class="kicker">Naša špecialita</span>
        <h2 class="text-3xl sm:text-4xl">Veľké akcie pre stovky detí</h2>
        <img
          src="/uploads/event-festival.svg"
          alt="Detská zóna na mestskom festivale"
          width="1200"
          height="800"
          loading="lazy"
          class="mt-6 rounded-blob object-cover lg:hidden"
        />
        <p class="mt-4 text-muted">
          Dni detí, mestské festivaly, školské podujatia či firemné rodinné dni – zvládame akcie
          pre desiatky aj stovky detí. Prídeme s vlastným tímom, technikou a programom na mieru,
          vy sa staráte len o zvyšok podujatia.
        </p>
        <ul class="mt-6 space-y-3 text-ink">
          <li class="flex items-start gap-3"><span class="font-bold text-brand-blue" aria-hidden="true">✓</span>Program na mieru podľa veku a počtu detí</li>
          <li class="flex items-start gap-3"><span class="font-bold text-brand-blue" aria-hidden="true">✓</span>Vlastný tím maskotov a animátorov</li>
          <li class="flex items-start gap-3"><span class="font-bold text-brand-blue" aria-hidden="true">✓</span>Ozvučenie a moderovanie v cene</li>
        </ul>
        <a href="/velke-akcie" class="btn-primary mt-8">Viac o veľkých akciách</a>
      </div>
      <img
        src="/uploads/event-festival.svg"
        alt=""
        aria-hidden="true"
        width="1200"
        height="800"
        loading="lazy"
        class="hidden rounded-blob object-cover lg:block"
      />
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container-site">
      <span class="kicker">Čo vieme zabezpečiť</span>
      <h2 class="max-w-xl text-3xl sm:text-4xl">Všetko pre detský program na jednom mieste</h2>
      <div class="mt-10">
        <ServiceGrid />
      </div>
      <div class="mt-12 flex flex-col items-center gap-5 rounded-blob bg-cream p-8 sm:flex-row sm:justify-between">
        <div class="flex flex-col items-center gap-4 text-center sm:flex-row sm:text-left">
          <div class="flex shrink-0 -space-x-3">
            {mascotTeaser.map((m) => (
              <img src={m.data.photo} alt={m.data.name} width="1200" height="800" loading="lazy" class="h-12 w-12 rounded-full border-2 border-white object-cover" />
            ))}
          </div>
          <p class="font-display font-bold">20+ maskotov – od Labkovej patroly po Ľadové kráľovstvo</p>
        </div>
        <a href="/maskoti" class="btn-primary shrink-0">Pozrieť maskotov</a>
      </div>
    </div>
  </section>

  <!-- Recent events -->
  <section class="section bg-cream">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <span class="kicker">Príbehy z akcií</span>
          <h2 class="text-3xl sm:text-4xl">Nedávne akcie</h2>
        </div>
        <a href="/akcie" class="btn-secondary !px-5 !py-2.5 text-sm">Všetky akcie</a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {recent.map((event) => <EventCard event={event} />)}
      </div>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/objednavka" class="btn-primary">Overiť dostupnosť termínu</a>
        <a href="/akcie" class="btn-secondary">Naše akcie</a>
      </div>
    </div>
  </section>

  <!-- Why Detičkovo -->
  <section class="section">
    <div class="container-site">
      <span class="kicker">Prečo Detičkovo</span>
      <h2 class="max-w-xl text-3xl sm:text-4xl">Skúsenosti, na ktoré sa môžete spoľahnúť</h2>
      <div class="mt-12">
        <StatBand />
      </div>
    </div>
  </section>

  <!-- References -->
  <section class="section bg-cream">
    <div class="container-site">
      <span class="kicker">Referencie</span>
      <h2 class="max-w-xl text-3xl sm:text-4xl">Povedali o nás</h2>
      <div class="mt-10">
        <ReferenceRow />
      </div>
    </div>
  </section>

  <CTASection />
</Base>
