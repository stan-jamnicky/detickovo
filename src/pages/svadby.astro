---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import CTASection from '../components/CTASection.astro';

const events = (await getCollection('events'))
  .filter((e) => e.data.eventType === 'svadba')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const perks = [
  { icon: '🏕️', title: 'Detský kútik v sále', text: 'Bezpečná zóna s hračkami, kde majú deti vlastný svet.' },
  { icon: '🎈', title: 'Animátori celý večer', text: 'Program od obradu až po tortu – deti sa nenudia ani minútu.' },
  { icon: '✂️', title: 'Tiché aktivity', text: 'Tvorivé dielne a hry, ktoré nerušia príhovory ani prvý tanec.' },
  { icon: '🌙', title: 'Večerný režim', text: 'Rozprávka a pokojný program, keď malým hosťom dochádzajú sily.' },
];
---

<Base
  title="Detský program na svadbu – Detičkovo"
  description="Detský kútik a animátori na vašu svadbu. Deti majú vlastný program, rodičia si užívajú hostinu a vy pokojný veľký deň."
>
  <section class="bg-cream">
    <div class="container-site py-16 sm:py-24">
      <span class="kicker">Svadby</span>
      <h1 class="max-w-3xl text-4xl sm:text-6xl">Vy máte svadbu. Deti majú nás.</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">
        Postaráme sa o všetky deti na svadbe – od najmenších po tínedžerov.
        Rodičia si vychutnajú hostinu aj parket a vy budete mať svadbu bez plačúcich prestávok.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/objednavka?typ=svadba" class="btn-primary">Overiť dostupnosť termínu</a>
        <a href="/akcie" class="btn-secondary">Pozrieť naše akcie</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <span class="kicker">Ako to funguje</span>
      <h2 class="max-w-xl text-3xl sm:text-4xl">Deti zabavené, rodičia na parkete</h2>
      <div class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-4">
        {perks.map((item) => (
          <div class="rounded-blob bg-cream p-6">
            <span class="text-3xl" aria-hidden="true">{item.icon}</span>
            <h3 class="mt-3 text-lg">{item.title}</h3>
            <p class="mt-1.5 text-sm text-muted">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {events.length > 0 && (
    <section class="section bg-cream">
      <div class="container-site">
        <span class="kicker">Zo svadieb</span>
        <h2 class="max-w-xl text-3xl sm:text-4xl">Svadby s Detičkovom</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {events.map((event) => <EventCard event={event} />)}
        </div>
        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <a href="/objednavka?typ=svadba" class="btn-primary">Overiť dostupnosť termínu</a>
          <a href="/akcie" class="btn-secondary">Naše akcie</a>
        </div>
      </div>
    </section>
  )}

  <CTASection
    title="Plánujete svadbu s malými hosťami?"
    text="Napíšte nám termín a približný počet detí. Navrhneme kútik aj program presne pre vašu svadbu."
    primaryLabel="Overiť dostupnosť termínu"
    primaryHref="/objednavka?typ=svadba"
  />
</Base>
