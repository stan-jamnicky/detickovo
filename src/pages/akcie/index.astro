---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import CTASection from '../../components/CTASection.astro';
import { EVENT_TYPES } from '../../lib/eventTypes';

const events = (await getCollection('events')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const usedTypes = EVENT_TYPES.filter((t) => events.some((e) => e.data.eventType === t.id));
---

<Base
  title="Naše akcie – Detičkovo"
  description="Príbehy z akcií, ktoré sme pripravili – dni detí, festivaly, firemné dni, svadby aj narodeninové oslavy. Pozrite si, ako vyzerá detský program od Detičkova."
>
  <section class="bg-cream">
    <div class="container-site py-16 sm:py-20">
      <span class="kicker">Príbehy z akcií</span>
      <h1 class="max-w-2xl text-4xl sm:text-6xl">Akcie, na ktorých sme zabávali</h1>
      <p class="mt-4 max-w-xl text-muted">Každá akcia je iná. Pozrite si, čo sme pripravili pre mestá, školy, firmy aj rodiny.</p>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <div class="mb-8 flex flex-wrap gap-2" role="group" aria-label="Filter podľa typu akcie">
        <button type="button" class="chip !bg-ink !text-white" data-filter="all">Všetky</button>
        {usedTypes.map((t) => (
          <button type="button" class="chip hover:bg-ink/10" data-filter={t.id}>{t.label}</button>
        ))}
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {events.map((event) => (
          <div data-event-type={event.data.eventType}>
            <EventCard event={event} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection title="Chcete podobnú akciu?" />
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-event-type]');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('!bg-ink', '!text-white'));
      btn.classList.add('!bg-ink', '!text-white');
      const filter = btn.dataset.filter;
      cards.forEach((card) => {
        card.style.display = filter === 'all' || card.dataset.eventType === filter ? '' : 'none';
      });
    });
  });
</script>
