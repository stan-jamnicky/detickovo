---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import EventCard from '../../components/EventCard.astro';
import CTASection from '../../components/CTASection.astro';
import { eventTypeLabel, EVENT_TYPES } from '../../lib/eventTypes';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const { title, date, location, childrenCount, eventType, services, cover, gallery, testimonial } = event.data;

const serviceEntries = (await Promise.all(services.map((id) => getEntry('services', id)))).filter(Boolean);
const typeInfo = EVENT_TYPES.find((t) => t.id === eventType);

const related = (await getCollection('events'))
  .filter((e) => e.id !== event.id && e.data.eventType === eventType)
  .slice(0, 3);

const allPhotos = [cover, ...gallery.filter((g) => g !== cover)];
const dateFormatted = date.toLocaleDateString('sk-SK', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={`${title} – Detičkovo`} description={`${title}: ${childrenCount} detí, ${location}. Pozrite si, aký program sme pripravili.`} ogImage={cover}>
  <article>
    <section class="bg-cream">
      <div class="container-site py-14 sm:py-20">
        <p class="text-sm font-bold uppercase tracking-widest text-brand-blue">{eventTypeLabel(eventType)}</p>
        <h1 class="mt-3 max-w-3xl text-4xl sm:text-6xl">{title}</h1>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="chip">📍 {location}</span>
          <span class="chip">🗓️ {dateFormatted}</span>
          <span class="chip">👧 {childrenCount} detí</span>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container-site grid gap-10 lg:grid-cols-[2fr_1fr]">
        <div>
          <Gallery images={allPhotos} title={title} />
          <div class="prose mt-8 max-w-none text-lg text-ink">
            <Content />
          </div>
        </div>
        <aside>
          <div class="rounded-blob bg-cream p-6">
            <h2 class="text-lg">Program na akcii</h2>
            <ul class="mt-4 space-y-3">
              {serviceEntries.map((s) => (
                <li class="flex items-center gap-3">
                  <span aria-hidden="true">{s!.data.icon}</span>
                  <span class="text-sm font-medium">{s!.data.title}</span>
                </li>
              ))}
            </ul>
            <a href={`/objednavka?typ=${eventType}`} class="btn-primary mt-6 w-full">Chcem podobnú akciu</a>
          </div>
        </aside>
      </div>
    </section>

    {testimonial && (
      <section class="pb-16 sm:pb-24">
        <div class="container-site">
          <figure class="relative overflow-hidden rounded-blob bg-white p-8 pt-10 shadow-lg shadow-ink/5 ring-1 ring-ink/5 sm:p-12 sm:pt-14">
            <span class="absolute inset-x-0 top-0 h-1.5 bg-brand-orange" aria-hidden="true"></span>
            <span class="absolute right-8 top-6 font-display text-8xl font-extrabold leading-none text-brand-orange opacity-20" aria-hidden="true">“</span>
            <blockquote class="relative max-w-4xl font-display text-xl font-semibold leading-snug text-ink sm:text-3xl">„{testimonial.quote}“</blockquote>
            <figcaption class="mt-5 flex items-center gap-3 text-sm font-bold text-muted">
              <span class="h-2 w-2 rounded-full bg-brand-orange" aria-hidden="true"></span>
              {testimonial.author}
            </figcaption>
          </figure>
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="section bg-cream">
        <div class="container-site">
          <h2 class="text-2xl sm:text-3xl">Ďalšie akcie – {typeInfo?.label}</h2>
          <div class="mt-8 grid gap-6 md:grid-cols-3">
            {related.map((e) => <EventCard event={e} />)}
          </div>
        </div>
      </section>
    )}
  </article>

  <CTASection title="Chcete podobnú akciu?" primaryHref={`/objednavka?typ=${eventType}`} />
</Base>
